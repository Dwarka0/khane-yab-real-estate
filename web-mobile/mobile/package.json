{
  "name": "khane-yab-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "assets:generate": "node scripts/generate-assets.mjs",
    "typecheck": "tsc --noEmit",
    "web": "expo start --web",
    "export:web": "expo export --platform web && node scripts/postprocess-web.mjs",
    "assets:web": "node scripts/generate-web-assets.mjs",
    "configure:web": "node scripts/configure-web.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "58.0.16",
    "expo-crypto": "58.0.7",
    "expo-font": "58.0.9",
    "expo-status-bar": "58.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/react": "19.3.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
