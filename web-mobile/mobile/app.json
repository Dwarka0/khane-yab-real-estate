{
  "expo": {
    "name": "خانه‌یاب",
    "slug": "khane-yab",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ir.khaneyab.app"
    },
    "android": {
      "package": "ir.khaneyab.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EAF3E9"
      }
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F8F5"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "خانه‌یاب",
      "shortName": "خانه‌یاب",
      "description": "جست‌وجو و پیشنهاد آگهی ملک بر اساس نیاز شما",
      "lang": "fa-IR",
      "dir": "rtl",
      "themeColor": "#1D5B44",
      "backgroundColor": "#F7F8F5",
      "display": "standalone",
      "orientation": "portrait",
      "favicon": "./public/favicon.png",
      "manifest": {
        "name": "خانه‌یاب",
        "short_name": "خانه‌یاب",
        "description": "جست‌وجو و پیشنهاد آگهی ملک بر اساس نیاز شما",
        "lang": "fa-IR",
        "dir": "rtl",
        "start_url": ".",
        "display": "standalone",
        "orientation": "portrait",
        "background_color": "#F7F8F5",
        "theme_color": "#1D5B44",
        "icons": [
          {
            "src": "/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
          },
          {
            "src": "/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
          },
          {
            "src": "/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
          }
        ]
      }
    }
  }
}
